# Test access to the bench Pi with a dedicated key (no password needed):
#   ssh -F tools/pi/ssh_config projektor-test 'uptime'
Host projektor-test
    HostName projektor.local
    User theater
    IdentityFile ~/.ssh/projektor_test
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    UserKnownHostsFile ~/.ssh/known_hosts_projektor
    LogLevel ERROR

# Server for backups + reverse tunnel (key lives in the Bitwarden SSH agent)
Host infmk1
    HostName infmk1.rufusreglet.ch
    User debian
    IdentityFile ~/.ssh/infmk1_debian.pub
    IdentitiesOnly yes
    ConnectTimeout 15
    LogLevel ERROR

# The projector through its reverse tunnel on infmk1 (works from anywhere)
Host projektor-remote
    HostName localhost
    Port 2222
    User theater
    IdentityFile ~/.ssh/projektor_test
    IdentitiesOnly yes
    ProxyJump infmk1
    StrictHostKeyChecking accept-new
    UserKnownHostsFile ~/.ssh/known_hosts_projektor_remote
    LogLevel ERROR
