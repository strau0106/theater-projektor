[Unit]
Description=Projektor WiFi manager (known networks, 15 s retry, hotspot fallback)
After=NetworkManager.service systemd-tmpfiles-setup.service
Wants=NetworkManager.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/sbin/projektor-wifi daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
